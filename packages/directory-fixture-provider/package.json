{
  "name": "directory-fixture-provider",
  "private": true,
  "version": "1.7.33",
  "description": "Provides directories for testing.",
  "main": "src/index.js",
  "scripts": {
    "pub": "npm version patch --force && npm publish",
    "test-common": "npx mocha --recursive tests/tests",
    "test-dev-unit": "npm run clean && npx mocha --recursive tests/tests/unit",
    "test-project": "echo directory-fixture-provider;pwd && node_modules/.bin/depcheck && npm run standard-fix",
    "test": "nyc --reporter=lcov --reporter=clover --reporter=text --cache npm run test-common",
    "test-all": "npm run test-project && npm test",
    "test-all-dev": "npm run test-project && npm run test-dev",
    "test-compiled": "mocha --require babel-core/register --require babel-polyfill --recursive dist/tests/tests",
    "build-src": "echo 1",
    "build-test": "echo 1",
    "prepublish": "npm run build-src && npm run build-test",
    "clean": "rimraf dist tmp && mkdir dist && mkdir tmp",
    "standard-fix": "standard --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsl-toolkit/dsl-toolkit.git"
  },
  "keywords": [
    "testing",
    "tests",
    "directory",
    "development",
    "tools",
    "tooling",
    "dsl-toolkit",
    "directory",
    "fixture",
    "fixtures"
  ],
  "author": "Imre Toth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dsl-toolkit/dsl-toolkit/issues"
  },
  "homepage": "https://github.com/dsl-toolkit/dsl-toolkit/tree/master/packages/directory-fixture-provider",
  "dependencies": {
    "directory-exists": "^2.0.1",
    "dsl-framework": "^1.8.39",
    "empty-dir": "^2.0.0",
    "fs-extra": "^9.1.0",
    "is-empty": "^1.2.0",
    "mkdirp": "^1.0.4",
    "pkg-dir": "^5.0.0",
    "randomstring": "^1.1.5",
    "recursive-readdir-sync": "^1.0.6"
  },
  "devDependencies": {
    "chai": "^4.3.6",
    "depcheck": "^1.4.0",
    "is-directory": "^0.3.1",
    "mocha": "^12.0.1",
    "nyc": "^15.1.0",
    "shelljs": "^0.8.4",
    "standard": "^16.0.3"
  },
  "engines": {
    "node": ">=6.4.0"
  },
  "nyc": {
    "exclude": [
      "**/tests/**"
    ]
  },
  "standard": {
    "ignore": [
      "/dist",
      "/coverage/",
      "/build/",
      "/tmp/"
    ]
  },
  "files": [
    "src/**"
  ],
  "gitHead": "f9cbf9ac2256495ddbf248fc2140c0fa215017cf"
}
