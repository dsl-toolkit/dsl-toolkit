{
  "name": "cowlog",
  "private": false,
  "version": "1.7.34",
  "description": "Development time logging for NodeJs",
  "homepage": "https://github.com/dsl-toolkit/dsl-toolkit/tree/master/packages/cowlog",
  "keywords": [
    "log",
    "logging",
    "tool",
    "tooling",
    "development",
    "cowlog"
  ],
  "bugs": {
    "url": "https://github.com/dsl-toolkit/dsl-toolkit/issues"
  },
  "main": "src/index.js",
  "scripts": {
    "pub": "npm version patch --force && npm publish",
    "test-common": "npx mocha --recursive tests/tests ",
    "test-dev-unit": "npm run clean && node_modules/.bin/mocha --recursive tests/tests/unit",
    "test-old": "npm run build && npm run test-compiled && npm run clean",
    "test": "PROD=true npx nyc --reporter=lcov --reporter=clover --reporter=text --cache npm run test-common",
    "test-project": "pwd && node_modules/.bin/depcheck   --ignores \"@types/node, eslint-plugin-standard\" && npm run standard-fix",
    "build-src": "echo 1",
    "build-test": "echo 1",
    "prepublish": "npm run build-src && npm run build-test",
    "clean": "echo 1",
    "standard-fix": "standard --fix src/index.js src/**/*.js tests/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsl-toolkit/dsl-toolkit.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Imre Toth",
    "email": "tothmimre@gmail.com"
  },
  "dependencies": {
    "array-ify": "^1.0.0",
    "array-unique": "^0.3.2",
    "bottlejs": "^2.0.0",
    "colors": "^1.4.0",
    "cowsay": "^1.2.0",
    "detect-node": "^2.1.0",
    "dsl-framework": "^1.8.39",
    "fclone": "^1.0.11",
    "flat": "^5.0.2",
    "is-function": "^1.0.2",
    "is-installed": "^2.0.1",
    "is-string": "^1.0.7",
    "isobject": "^4.0.0",
    "jimple": "^1.5.0",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "mime-types": "^2.1.33",
    "object-hash": "^2.2.0",
    "object-path": "^0.11.8",
    "sha256": "^0.2.0",
    "stacktrace-js": "^2.0.2",
    "stringify-object": "^3.3.0",
    "write": "^2.0.0"
  },
  "peerDependencies": {
    "lolcatjs": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^17.0.38",
    "chai": "^4.3.0",
    "depcheck": "^1.4.3",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.3.1",
    "eslint-plugin-standard": "^5.0.0",
    "generic-text-linker": "^1.7.37",
    "glob": "^7.1.6",
    "mocha": "^12.0.1",
    "nyc": "^15.1.0",
    "standard": "^16.0.4",
    "strip-ansi": "^6.0.0"
  },
  "engines": {
    "node": ">=11"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "**/tests/**"
    ],
    "check-coverage": true,
    "per-file": true,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  },
  "standard": {
    "ignore": [
      "/dist/",
      "/coverage/",
      "/build/",
      "/tmp/"
    ],
    "globals": [
      "l"
    ]
  },
  "files": [
    "src/**"
  ],
  "gitHead": "c6eed48a0d905a0a4b2c5c404d843343539f7d7d"
}
